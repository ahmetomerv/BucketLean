{
  "name": "r2-jpeg-optimizer",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "nuxt dev --host 127.0.0.1",
    "build": "nuxt build",
    "start": "node .output/server/index.mjs",
    "typecheck": "nuxt typecheck",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage --silent",
    "test:smoke": "node scripts/smoke.mjs",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "docs:check": "npm run docs:build && node scripts/docs-smoke.mjs && node scripts/docs-dev-smoke.mjs",
    "db:snapshot": "node scripts/snapshot-db.mjs",
    "manifest:backfill": "node scripts/backfill-manifests.mjs",
    "restore:drill": "node scripts/restore-drill.mjs",
    "check": "npm run test:coverage && npm run typecheck && npm run build && npm run test:smoke && npm run test:dev-smoke && npm run docs:check",
    "test:dev-smoke": "node scripts/dev-smoke.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.0.0",
    "@tailwindcss/vite": "^4.0.0",
    "better-sqlite3": "^12.0.0",
    "drizzle-orm": "^0.44.0",
    "exiftool-vendored": "^38.1.0",
    "nuxt": "^4.0.0",
    "sharp": "^0.35.4",
    "tailwindcss": "^4.0.0",
    "vue": "^3.0.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.0",
    "@vitejs/plugin-vue": "^6.0.9",
    "@vitest/coverage-v8": "^3.2.7",
    "@vue/test-utils": "^2.5.1",
    "happy-dom": "^20.14.5",
    "mermaid": "^11.17.2",
    "typescript": "^5.0.0",
    "vitepress": "^1.6.4",
    "vitepress-plugin-mermaid": "^2.0.17",
    "vitest": "^3.0.0",
    "vue-tsc": "^2.0.0"
  },
  "overrides": {
    "vitepress": {
      "vite": "6.4.3"
    }
  },
  "engines": {
    "node": ">=22"
  }
}
