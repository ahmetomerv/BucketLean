# Single bucket: use these four values. The bucket profile ID is "default".
R2_ENDPOINT=https://YOUR_ACCOUNT_ID.r2.cloudflarestorage.com
R2_BUCKET=your-bucket
R2_ACCESS_KEY_ID=your-access-key-id
R2_SECRET_ACCESS_KEY=your-secret-access-key

# Multiple buckets: leave the four values above empty and use one JSON array.
# Repeat account-wide credentials for each bucket they may access; use distinct
# credentials for a bucket-scoped token. IDs remain stable once jobs exist.
# R2_ENDPOINT=
# R2_BUCKET=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKETS_JSON='[{"id":"photos","endpoint":"https://YOUR_ACCOUNT_ID.r2.cloudflarestorage.com","bucket":"photos","accessKeyId":"key","secretAccessKey":"secret"},{"id":"media","endpoint":"https://YOUR_ACCOUNT_ID.r2.cloudflarestorage.com","bucket":"media","accessKeyId":"key","secretAccessKey":"secret"}]'

APP_PASSWORD=choose-a-long-private-password
DATABASE_PATH=.data/optimizer.sqlite
